# ==============================================================================
# ENVIRONMENT VARIABLES REFERENCE (.env.example)
# Loaded by backend at: backend/.env via python-dotenv (BASE_DIR.parent / '.env')
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------------------
# Django secret key used for security, token signing, and session encryption.
# In production, replace with a strong, randomly generated string.
SECRET_KEY=django-insecure-dev-key-change-in-production-2026

# Name of the relational database.
DATABASE_NAME=vibe_ecommerce_db

# Database user account name for authentication.
DATABASE_USER=postgres

# Database user password for authentication.
DATABASE_PASSWORD=postgres


# ------------------------------------------------------------------------------
# OPTIONAL (Defaults exist in settings.py)
# ------------------------------------------------------------------------------
# Controls debug mode (True / False). Defaults to True.
DEBUG=True

# Specifies database driver ('postgresql' for production, 'sqlite' for quick dev fallback). Defaults to 'postgresql'.
DATABASE_ENGINE=postgresql

# Host address of the database server. Defaults to 'localhost'.
DATABASE_HOST=localhost

# Network port of the database server. Defaults to '5432'.
DATABASE_PORT=5432


# ------------------------------------------------------------------------------
# PRODUCTION ONLY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed host/domain names serving the backend.
# In development, defaults to '*'. In production, set to your specific domain names (e.g., api.yourdomain.com).
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com
